# ==============================================================================
# 🖨️ DropPrint - Self-Service QR Printing Counter Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# [SERVER] - Core HTTP Server & Process Settings
# ------------------------------------------------------------------------------
# PORT: TCP port on which the DropPrint FastAPI server listens for incoming HTTP traffic.
# Default: 8000
PORT=8000

# HOST: Network interface binding. 0.0.0.0 binds to all network interfaces.
# Default: 0.0.0.0
HOST=0.0.0.0

# ENVIRONMENT: Server runtime environment (production | development | testing).
# Default: production
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# [PRICING] - Linear Pricing Engine (Honest Counter Rates)
# ------------------------------------------------------------------------------
# Currency: Indian Rupee (INR / ₹)
# PRICE_BW_PER_PAGE: Rate charged per single monochrome (black & white) page.
# Default: 2.00
PRICE_BW_PER_PAGE=2.00

# PRICE_COLOR_PER_PAGE: Rate charged per single color page.
# Default: 10.00
PRICE_COLOR_PER_PAGE=10.00

# DUPLEX_DISCOUNT: Discount applied per physical double-sided sheet saved (pages // 2).
# Example: 2 pages duplex B&W = (2 * 2.00) - (1 * 0.50) = ₹3.50.
# Default: 0.50
DUPLEX_DISCOUNT=0.50

# MIN_CHARGE: Minimum charge floor. Setting to 0.0 enforces strictly honest,
# proportional pricing with zero arbitrary minimum surcharges.
# Default: 0.0
MIN_CHARGE=0.0

# ------------------------------------------------------------------------------
# [PRIVACY] - Customer Document Lifecycle & Auto-Purge Privacy Guarantee
# ------------------------------------------------------------------------------
# FILE_RETENTION_SECONDS: Number of seconds to retain customer uploaded files on
# disk after print completion before automatic, irreversible unlinking.
# Guarantee: 60 seconds (1 minute). Files are wiped from disk, while accounting
# metadata (pickup code, specs, cash collected, timestamp) is retained in SQLite.
# Default: 60
FILE_RETENTION_SECONDS=60

# SWEEPER_INTERVAL_SECONDS: Cadence in seconds at which the background garbage
# collection loop runs to sweep away completed files, cancelled jobs, and abandoned uploads.
# Default: 30
SWEEPER_INTERVAL_SECONDS=30

# ABANDONED_TTL_SECONDS: Maximum time in seconds an unprinted upload may sit on disk.
# Default: 600 (10 minutes)
ABANDONED_TTL_SECONDS=600

# ------------------------------------------------------------------------------
# [NETWORK] - Cloudflare Tunnel & Local LAN Settings
# ------------------------------------------------------------------------------
# PUBLIC_TUNNEL_URL: The public HTTPS endpoint exposed by Cloudflare Quick Tunnel
# or Named Tunnel. Customer mobile devices on cellular data (4G/5G) scan the QR
# standee and reach this URL without joining the shop's Wi-Fi network.
PUBLIC_TUNNEL_URL=https://your-tunnel-name.trycloudflare.com

# LAN_IP: The local IPv4 address of the shop counter PC (e.g. 192.168.1.100).
# Displayed in the QR standee modal as a fallback URL for customers on local Wi-Fi.
LAN_IP=10.57.27.212

# ------------------------------------------------------------------------------
# [DATABASE & STORAGE] - Persistence Paths
# ------------------------------------------------------------------------------
# PRINT_SYSTEM_DB_PATH: Relative or absolute path to the SQLite persistence database.
# Default: data/print_system.db
PRINT_SYSTEM_DB_PATH=data/print_system.db

# DATA_DIR: Directory for database and persistent telemetry.
DATA_DIR=data

# UPLOADS_DIR: Directory for temporary customer uploads and spool outputs.
UPLOADS_DIR=uploads

# SCANS_DIR: Directory for scanned documents (if using eSCL/AirScan hardware).
SCANS_DIR=scans

# ------------------------------------------------------------------------------
# [SECURITY] - Authentication Secrets & Session Lifetime
# ------------------------------------------------------------------------------
# SESSION_SECRET: Cryptographic HMAC key used to sign shopkeeper authentication tokens.
# Generate a strong 64-character secret in production.
SESSION_SECRET=shopkeeper-jwt-dev-secret-change-in-production-0987654321

# DEFAULT_SHOP_ID: Default identifier for the counter shop instance.
DEFAULT_SHOP_ID=default

# ------------------------------------------------------------------------------
# [HARDWARE & DRIVERLESS IPP] - Windows Print Spooler Integration
# ------------------------------------------------------------------------------
# MFP_IPP_PORT: Standard IPP port for Windows/macOS/Linux driverless printing (631).
# Set to 0 to disable IPP listener if port 631 is unavailable without Administrator rights.
MFP_IPP_PORT=631

# MFP_MDNS: Enable mDNS / Bonjour network advertisement for zero-configuration discovery.
# Values: yes | no
MFP_MDNS=yes

# MFP_ESCL: Enable eSCL / AirScan driverless scanning endpoint.
# Values: yes | no
MFP_ESCL=yes

# MFP_ESCL_PORT: Dedicated port for eSCL scanning requests (port 80).
# Set to 0 to serve eSCL solely on the primary web port.
MFP_ESCL_PORT=80
